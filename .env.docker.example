# LOCAL DEVELOPMENT ONLY. These defaults preserve compatibility with the
# existing postgres:17 Compose volume used by the previous PrivaCheck setup.
# Do not use these credentials for a public deployment.
POSTGRES_DB=privacheck
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

POSTGRES_PORT=5432
VALKEY_PORT=6379
API_PORT=8000
FRONTEND_PORT=5173

ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

AUTH_SESSION_TTL_DAYS=7
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_LOGIN_RATE_LIMIT=5
AUTH_LOGIN_RATE_WINDOW_SECONDS=60
AUTH_REGISTER_RATE_LIMIT=3
AUTH_REGISTER_RATE_WINDOW_SECONDS=3600

CRAWLER_TIMEOUT_SECONDS=180
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
