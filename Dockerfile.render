# Render Free: one HTTPS origin, FastAPI + compiled Vite React SPA.
# This DOES NOT install Chromium or start Celery. Both workers stay on laptop.
FROM node:22-alpine AS frontend-build
WORKDIR /site
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
ENV VITE_API_BASE_URL=/api \
    VITE_USE_MOCK_DATA=false
RUN npm run build

FROM python:3.12-slim-bookworm AS web
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PRIVACHECK_SERVE_FRONTEND=1
WORKDIR /app
COPY requirements-web.txt ./
RUN python -m pip install --no-cache-dir -r requirements-web.txt
COPY backend/ ./backend/
COPY alembic/ ./alembic/
COPY alembic.ini ./alembic.ini
COPY rules/ ./rules/
COPY --from=frontend-build /site/dist/ ./frontend_dist/
RUN groupadd --system --gid 10001 privacheck \
    && useradd --system --uid 10001 --gid privacheck --home-dir /home/privacheck --create-home privacheck \
    && chown -R privacheck:privacheck /app /home/privacheck
USER privacheck:privacheck
EXPOSE 10000
CMD ["sh", "-c", "exec python -m uvicorn backend.api.main:app --host 0.0.0.0 --port ${PORT:-10000} --proxy-headers"]
