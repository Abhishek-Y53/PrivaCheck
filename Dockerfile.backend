# Shared runtime image for FastAPI, Alembic migrations, and both Celery workers.
# Python 3.12 is used for broad wheel availability across Playwright and spaCy.
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

WORKDIR /app

COPY requirements.txt /app/requirements.txt
RUN python -m pip install --upgrade pip \
    && python -m pip install --no-cache-dir -r /app/requirements.txt \
    && python -m playwright install --with-deps chromium \
    && rm -rf /var/lib/apt/lists/*

# Copy only runtime source and configuration; tests and local environment files
# are excluded by .dockerignore.
COPY backend/ /app/backend/
COPY rules/ /app/rules/
COPY alembic/ /app/alembic/
COPY alembic.ini /app/alembic.ini

# Run application code as an unprivileged account. Browser binaries remain
# readable/executable by this account.
RUN groupadd --system --gid 10001 privacheck \
    && useradd --system --uid 10001 --gid privacheck --create-home --home-dir /home/privacheck privacheck \
    && mkdir -p /app/artifacts /app/screenshots /ms-playwright \
    && chown -R privacheck:privacheck /app /home/privacheck /ms-playwright

USER privacheck:privacheck

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "backend.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
