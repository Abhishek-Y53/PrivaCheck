# TEMPLATE ONLY. Place actual secrets in repo-root .env.render-workers,
# which is ignored by .gitignore. Never paste this file's secret values.
ENVIRONMENT=production
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
FRONTEND_ORIGIN=https://YOUR-ASSIGNED-NAME.onrender.com
CORS_ORIGINS=https://YOUR-ASSIGNED-NAME.onrender.com
GOOGLE_REDIRECT_URI=https://YOUR-ASSIGNED-NAME.onrender.com/auth/google/callback
# Use Render's EXTERNAL Postgres hostname, never the internal one.
# Adapt postgres:// -> postgresql+psycopg:// and append sslmode=require.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@EXTERNAL-PG-HOST/DBNAME?sslmode=require
# Use Render's EXTERNAL Key Value hostname after allowing your public IPv4.
# For Celery's Redis broker + result backend, ssl_cert_reqs is required.
BROKER_URL=rediss://default:PASSWORD@EXTERNAL-REDIS-HOST:6379/0?ssl_cert_reqs=required
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=1
CRAWLER_TIMEOUT_SECONDS=180
CRAWLER_HEADLESS=true
