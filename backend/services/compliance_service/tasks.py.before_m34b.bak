"""Compliance queue tasks.

This stage registers a contract-validating worker probe only. The real YAML
rule-evaluation task will be introduced after queue isolation is verified.
"""

from __future__ import annotations

from typing import Any

from backend.contracts.task_messages import (
    ComplianceEvaluationRequested,
    parse_task_message,
)
from backend.infrastructure.messaging.celery_app import celery_app


@celery_app.task(
    bind=True,
    name="privacheck.compliance.worker_probe",
    ignore_result=False,
)
def compliance_worker_probe(
    self: Any,
    payload: dict[str, object],
) -> dict[str, str | int]:
    """Validate an evaluation request envelope and acknowledge its queue."""
    message = parse_task_message(payload)
    if not isinstance(message, ComplianceEvaluationRequested):
        raise ValueError("Compliance worker received an unsupported message type.")

    return {
        "status": "ok",
        "service": "compliance",
        "schema_version": message.schema_version,
        "message_id": str(message.message_id),
        "scan_id": str(message.scan_id),
        "framework_id": message.framework_id,
        "task_id": str(self.request.id),
        "worker": str(self.request.hostname or "unknown"),
    }
