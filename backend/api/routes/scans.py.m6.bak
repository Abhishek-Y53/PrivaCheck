"""Asynchronous scan submission, status, report, and listing endpoints."""

from typing import Literal
from uuid import UUID

from fastapi import APIRouter, HTTPException, Query, status

from backend.api.schemas import (
    ScanAcceptedResponse,
    ScanListResponse,
    ScanReportResponse,
    ScanRequest,
    ScanStatusResponse,
)
from backend.api.services.async_scan_service import (
    AsyncScanService,
    ScanEnqueueError,
    ScanNotFoundError,
    ScanReportNotReadyError,
    ScanServiceUnavailableError,
    UnsupportedFrameworkError,
)

router = APIRouter(prefix="/scans", tags=["Scans"])
scan_service = AsyncScanService()

LifecycleFilter = Literal["QUEUED", "RUNNING", "COMPLETED", "FAILED", "CANCELLED"]


@router.post(
    "",
    response_model=ScanAcceptedResponse,
    status_code=status.HTTP_202_ACCEPTED,
    summary="Submit an asynchronous website scan",
    description=(
        "Creates a scan record and submits a crawler task. The response is "
        "returned immediately; retrieve execution status and the final report "
        "using the URLs in the response."
    ),
)
async def create_scan(request: ScanRequest) -> ScanAcceptedResponse:
    try:
        return await scan_service.submit_scan(request)
    except UnsupportedFrameworkError as exc:
        raise HTTPException(status_code=422, detail=str(exc)) from exc
    except ScanEnqueueError as exc:
        raise HTTPException(
            status_code=503,
            detail={
                "message": "The scan could not be submitted to the processing queue.",
                "scan_id": str(exc.scan_id),
            },
        ) from None
    except ScanServiceUnavailableError:
        raise HTTPException(
            status_code=503,
            detail="The scan service is temporarily unavailable.",
        ) from None


@router.get(
    "",
    response_model=ScanListResponse,
    summary="List recent scans",
)
async def list_scans(
    limit: int = Query(default=20, ge=1, le=100),
    offset: int = Query(default=0, ge=0),
    lifecycle_status: LifecycleFilter | None = Query(default=None),
) -> ScanListResponse:
    try:
        return await scan_service.list_scans(
            limit=limit,
            offset=offset,
            lifecycle_status=lifecycle_status,
        )
    except ScanServiceUnavailableError:
        raise HTTPException(
            status_code=503,
            detail="The scan service is temporarily unavailable.",
        ) from None


@router.get(
    "/{scan_id}",
    response_model=ScanStatusResponse,
    summary="Get scan execution status",
)
async def get_scan_status(scan_id: UUID) -> ScanStatusResponse:
    try:
        return await scan_service.get_scan_status(scan_id)
    except ScanNotFoundError:
        raise HTTPException(status_code=404, detail="Scan not found.") from None
    except ScanServiceUnavailableError:
        raise HTTPException(
            status_code=503,
            detail="The scan service is temporarily unavailable.",
        ) from None


@router.get(
    "/{scan_id}/report",
    response_model=ScanReportResponse,
    summary="Get the final compliance report",
)
async def get_scan_report(scan_id: UUID) -> ScanReportResponse:
    try:
        return await scan_service.get_scan_report(scan_id)
    except ScanNotFoundError:
        raise HTTPException(status_code=404, detail="Scan not found.") from None
    except ScanReportNotReadyError as exc:
        raise HTTPException(
            status_code=409,
            detail={
                "message": "The final report is not available.",
                "lifecycle_status": exc.lifecycle_status,
                "error": exc.error,
            },
        ) from None
    except ScanServiceUnavailableError:
        raise HTTPException(
            status_code=503,
            detail="The scan service is temporarily unavailable.",
        ) from None
